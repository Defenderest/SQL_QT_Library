  <property name="styleSheet">
   <string notr="true">/* Dark Theme for Login Dialog */
QDialog#LoginDialog {
    background-color: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
}

/* Labels */
QLabel {
    color: #e0e0e0;
    font-size: 10pt;
    background: transparent;
}

/* Title */
QLabel#titleLabel {
    color: #ffffff;
    font-size: 18pt;
    font-weight: bold;
    margin-bottom: 15px;
    margin-top: 10px;
}

/* Error Label */
QLabel#errorLabel {
    color: #ff5555;
    font-weight: bold;
    min-height: 20px;
}

/* Input Fields */
QLineEdit {
    background-color: #1a1a1a;
    border: 1px solid #333333;
    padding: 10px 14px;
    border-radius: 6px;
    color: #ffffff;
    font-size: 11pt;
}

QLineEdit:focus {
    border-color: #c9a962;
    background-color: #252525;
}

QLineEdit::placeholder {
    color: #666666;
}

/* Buttons Base */
QPushButton {
    border: 1px solid #333333;
    padding: 10px 20px;
    border-radius: 6px;
    font-size: 10pt;
    font-weight: 600;
    min-width: 100px;
}

/* Primary Button (Login/Register) */
QPushButton#okButton, QPushButton#loginButton, QPushButton#registerButton {
    background-color: #c9a962;
    color: #0d0d0d;
    border-color: #c9a962;
}

QPushButton#okButton:hover, QPushButton#loginButton:hover, QPushButton#registerButton:hover {
    background-color: #d4b876;
    border-color: #d4b876;
}

QPushButton#okButton:pressed, QPushButton#loginButton:pressed, QPushButton#registerButton:pressed {
    background-color: #b89a4f;
    border-color: #b89a4f;
}

QPushButton#okButton:disabled {
    background-color: #333333;
    border-color: #444444;
    color: #666666;
}

/* Cancel Button */
QPushButton#cancelButton {
    background-color: transparent;
    color: #888888;
    border: 1px solid #333333;
}

QPushButton#cancelButton:hover {
    background-color: #1f1f1f;
    border-color: #c9a962;
    color: #c9a962;
}

QPushButton#cancelButton:pressed {
    background-color: #c9a962;
    border-color: #c9a962;
    color: #0d0d0d;
}

/* Link Buttons */
QPushButton#switchToRegisterButton, QPushButton#switchToLoginButton {
    background-color: transparent;
    border: none;
    color: #c9a962;
    text-decoration: underline;
    padding: 4px;
    min-width: 0;
    font-size: 9pt;
    font-weight: normal;
    border-radius: 0;
}

QPushButton#switchToRegisterButton:hover, QPushButton#switchToLoginButton:hover {
    color: #d4b876;
}

QPushButton#switchToRegisterButton:pressed, QPushButton#switchToLoginButton:pressed {
    color: #b89a4f;
}

/* Form Layout */
QFormLayout {
    vertical-spacing: 14px;
    horizontal-spacing: 10px;
    margin-top: 15px;
}</string>
