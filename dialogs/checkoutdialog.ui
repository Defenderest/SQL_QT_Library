  <property name="styleSheet">
   <string notr="true">
QDialog#CheckoutDialog {
    background-color: #141414;
    border: 1px solid #2a2a2a;
}

QGroupBox {
    border: 1px solid #2a2a2a;
    margin-top: 10px;
    padding-top: 15px;
    background-color: #1a1a1a;
    border-radius: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 5px 10px;
    color: #c9a962;
    font-weight: bold;
}

QLabel {
    color: #e0e0e0;
    padding: 2px;
    background: transparent;
}

QLabel#nameLabel, QLabel#emailLabel {
    font-weight: normal;
    color: #ffffff;
}

QLineEdit, QComboBox {
    padding: 10px 14px;
    border: 1px solid #333333;
    border-radius: 6px;
    background-color: #141414;
    color: #ffffff;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #c9a962;
    background-color: #1f1f1f;
}

QLineEdit::placeholder {
    color: #666666;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QLabel#totalAmountLabel {
    font-size: 14pt;
    font-weight: bold;
    color: #c9a962;
    padding-top: 10px;
    padding-bottom: 5px;
}

QDialogButtonBox QPushButton {
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 600;
    min-width: 100px;
}

QDialogButtonBox QPushButton[text="OK"] {
    background-color: #c9a962;
    color: #0d0d0d;
    border: 1px solid #c9a962;
}
QDialogButtonBox QPushButton[text="OK"]:hover {
    background-color: #d4b876;
    border-color: #d4b876;
}
QDialogButtonBox QPushButton[text="OK"]:pressed {
    background-color: #b89a4f;
    border-color: #b89a4f;
}

QDialogButtonBox QPushButton[text="Cancel"] {
    background-color: transparent;
    color: #888888;
    border: 1px solid #333333;
}
QDialogButtonBox QPushButton[text="Cancel"]:hover {
    background-color: #1f1f1f;
    border-color: #c9a962;
    color: #c9a962;
}
QDialogButtonBox QPushButton[text="Cancel"]:pressed {
    background-color: #c9a962;
    border-color: #c9a962;
    color: #0d0d0d;
}

Line {
    background-color: #2a2a2a;
    height: 1px;
}</string>
