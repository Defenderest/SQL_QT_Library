  <property name="styleSheet">
   <string notr="true">/* Dark Theme for Profile Dialog */
QDialog {
    background-color: #141414;
    border: 1px solid #2a2a2a;
}

QWidget {
    font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 10pt;
    color: #e0e0e0;
    background: transparent;
}

/* Profile Header */
QLabel#profileHeaderLabel {
   font-size: 16pt;
   font-weight: 600;
   color: #c9a962;
   margin-bottom: 15px;
   padding-bottom: 5px;
   border-bottom: 1px solid #2a2a2a;
}

/* Field Labels */
QLabel[objectName^="label_"] {
  font-weight: 600;
  color: #888888;
  padding-top: 3px;
}

/* Field Values */
QLabel#firstNameLabel, QLabel#lastNameLabel, QLabel#emailLabel,
QLabel#phoneLabel, QLabel#addressLabel, QLabel#joinDateLabel,
QLabel#loyaltyLabel, QLabel#pointsLabel {
    font-weight: 400;
    color: #ffffff;
    padding-top: 3px;
}

/* Input Fields */
QLineEdit {
    padding: 10px 14px;
    border: 1px solid #333333;
    border-radius: 6px;
    background-color: #1a1a1a;
    color: #ffffff;
    font-size: 10pt;
}

QLineEdit:focus {
    border-color: #c9a962;
    background-color: #252525;
}

QLineEdit::placeholder {
    color: #666666;
}

/* Dialog Buttons */
QDialogButtonBox QPushButton {
    padding: 10px 20px;
    background-color: #c9a962;
    color: #0d0d0d;
    border: 1px solid #c9a962;
    border-radius: 6px;
    font-weight: 600;
    min-height: 36px;
    font-size: 10pt;
    min-width: 100px;
}

QDialogButtonBox QPushButton:hover {
    background-color: #d4b876;
    border-color: #d4b876;
}

QDialogButtonBox QPushButton:pressed {
    background-color: #b89a4f;
    border-color: #b89a4f;
}
</string>
